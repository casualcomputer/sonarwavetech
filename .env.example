# Vercel: Project → Settings → Environment Variables
# - Add NEXT_PUBLIC_GOOGLE_ANALYTICS for Production (and Preview if you want GA on preview URLs).
# - Redeploy after saving; NEXT_PUBLIC_* is inlined at build time.
# - Optional: pull locally with `vercel env pull .env.local`

NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_GOOGLE_ADS_ID=
